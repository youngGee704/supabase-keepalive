# Port (Render will set this automatically)
PORT=3000

# Supabase Project IDs (comma-separated)
# Format: Just the project ID part (e.g., "abc123xyz")
# You can find this in your Supabase project URL: https://abc123xyz.supabase.co

# Single project: SUPABASE_PROJECT_IDS=abc123xyz
# Multiple projects: SUPABASE_PROJECT_IDS=abc123xyz,def456uvw,ghi789rst
#
SUPABASE_PROJECT_IDS=
